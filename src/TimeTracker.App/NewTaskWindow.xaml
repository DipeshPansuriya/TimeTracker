<Window x:Class="TimeTracker.App.NewTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Border Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="#ECECE4">
        <Border.Effect>
            <DropShadowEffect Color="#081F4B" BlurRadius="28" ShadowDepth="6" Opacity="0.22"/>
        </Border.Effect>

        <StackPanel>
            <Border Height="4" Background="#081F4B" CornerRadius="8,8,0,0"/>

            <StackPanel Margin="24,20,24,22">
                <TextBlock Text="What are you working on?" Foreground="#081F4B"
                           FontSize="20" FontWeight="Bold" FontFamily="Segoe UI"/>
                <TextBlock x:Name="CarryNote" Foreground="#585858" FontSize="12"
                           FontFamily="Segoe UI" Margin="0,4,0,18" TextWrapping="Wrap"/>

                <TextBlock Text="TASK" Style="{StaticResource DialogLabel}"/>
                <TextBox x:Name="TitleBox" Style="{StaticResource DialogInput}"/>

                <TextBlock Text="CUSTOMER" Style="{StaticResource DialogLabel}"/>
                <TextBox x:Name="CustomerBox" Style="{StaticResource DialogInput}"/>

                <TextBlock Text="DESCRIPTION (OPTIONAL)" Style="{StaticResource DialogLabel}"/>
                <TextBox x:Name="DescriptionBox" Style="{StaticResource DialogInput}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="64"
                         VerticalScrollBarVisibility="Auto"/>

                <TextBlock x:Name="ErrorText" Foreground="#C62828" FontSize="12"
                           FontFamily="Segoe UI" Margin="0,0,0,10" Visibility="Collapsed"
                           TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="OnCancel" Style="{StaticResource DialogGhost}"
                            Margin="0,0,8,0" IsCancel="True"/>
                    <Button Content="Start task" Click="OnConfirm"
                            Style="{StaticResource DialogPrimary}" IsDefault="True"/>
                </StackPanel>
            </StackPanel>

            <Border Height="4" Background="#EB4A26" CornerRadius="0,0,8,8"/>
        </StackPanel>
    </Border>
</Window>
