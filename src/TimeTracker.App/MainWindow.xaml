<Window x:Class="TimeTracker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Time tracker" Width="330" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        MouseLeftButtonDown="OnDrag">

    <Border Background="#081F4B" CornerRadius="8" BorderThickness="1" BorderBrush="#3876CBFF">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="4" Opacity="0.45"/>
        </Border.Effect>

        <StackPanel>
            <Border Background="#0DFFFFFF" CornerRadius="8,8,0,0" Padding="14,10"
                    BorderThickness="0,0,0,1" BorderBrush="#2876CBFF">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Width="14" Height="14" Stretch="Uniform" Fill="#EB4A26"
                          Data="M 82,42 L 43,80 L 53,80 L 105,132 L 105,142 L 66,142 L 0,75 L 39,36 L 82,36 Z M 148,51 L 172,75 L 132,115 L 89,115 L 89,110 L 128,70 L 118,70 L 59,11 L 59,0 L 96,0 Z"/>
                    <TextBlock Grid.Column="1" Text="Time tracker" Foreground="White"
                               FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                               Margin="9,0,0,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Settings" Click="OnSettings"
                                Style="{StaticResource TitleBarButton}"
                                ToolTip="Working hours, reminders and notifications"/>
                    <!-- A Button, not a TextBlock with a mouse handler. The window drags on
                         MouseLeftButtonDown, and DragMove captures the mouse, so a
                         MouseLeftButtonUp on a child element never arrives. A Button
                         handles the click itself and stops it bubbling to the drag. -->
                        <Button Content="Hide" Click="OnHide"
                                Style="{StaticResource TitleBarButton}"
                                ToolTip="Hide to tray - the day keeps running"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Margin="14,13,14,14">

                <Grid Margin="0,0,0,13">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{Binding StateColour}"/>
                        <TextBlock Text="{Binding StateText}" Foreground="White" FontSize="13"
                                   FontWeight="SemiBold" Margin="8,0,0,0" FontFamily="Segoe UI"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" Background="#76CBFF" CornerRadius="9"
                            Padding="7,2">
                        <TextBlock Text="{Binding LocationText}" Foreground="#081F4B" FontSize="9"
                                   FontWeight="Bold" FontFamily="Segoe UI"/>
                    </Border>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Time in" Style="{StaticResource Key}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TimeIn}" Style="{StaticResource Val}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Worked" Style="{StaticResource Key}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Worked}" Style="{StaticResource ValBig}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Required" Style="{StaticResource Key}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Required}" Style="{StaticResource Val}"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding BalanceLabel}" Style="{StaticResource Key}"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BalanceValue}" Style="{StaticResource Val}"/>
                </Grid>

                <Grid Height="7" Margin="0,13,0,4">
                    <Border Background="#1FFFFFFF" CornerRadius="4"/>
                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="#76CBFF" Height="7"/>
                </Grid>
                <Grid Margin="0,0,0,13">
                    <TextBlock Text="0:00" Style="{StaticResource Scale}" HorizontalAlignment="Left"/>
                    <TextBlock Text="Half day" Style="{StaticResource Scale}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Full day" Style="{StaticResource Scale}" HorizontalAlignment="Right"/>
                </Grid>

                <Border BorderThickness="3,1,1,1" BorderBrush="#76CBFF" CornerRadius="4"
                        Background="#0DFFFFFF" Padding="10,8" Margin="0,0,0,13">
                    <StackPanel>
                        <TextBlock Text="CURRENT TASK" Foreground="#CC76CBFF" FontSize="9"
                                   FontFamily="Segoe UI" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CurrentTaskTitle}" Foreground="White"
                                   FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0"
                                   FontFamily="Segoe UI"/>
                        <Grid Margin="0,5,0,0">
                            <TextBlock Text="{Binding CurrentTaskCustomer}" Foreground="#76CBFF"
                                       FontSize="10.5" FontFamily="Consolas"/>
                            <TextBlock Text="{Binding CurrentTaskDuration}" Foreground="#76CBFF"
                                       FontSize="10.5" FontFamily="Consolas"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <UniformGrid Columns="3" Margin="0,0,0,13">
                    <Button x:Name="BtnPrimary" Content="Continue" Click="OnPrimary"
                            Style="{StaticResource Primary}" Margin="0,0,3,0"/>
                    <Button Content="New task" Click="OnNewTask"
                            Style="{StaticResource Ghost}" Margin="3,0"/>
                    <Button x:Name="BtnBreak" Content="Break" Click="OnBreak"
                            Style="{StaticResource Ghost}" Margin="3,0,0,0"/>
                </UniformGrid>

                <Border BorderThickness="0,1,0,0" BorderBrush="#2876CBFF" Padding="0,11,0,0">
                    <UniformGrid Columns="3">
                        <Button Click="OnOpenSummary" Style="{StaticResource FooterButton}"
                                ToolTip="Open the full report">
                            <StackPanel>
                                <TextBlock Text="TODAY" Style="{StaticResource FootKey}"/>
                                <TextBlock Text="{Binding TodayTotal}" Style="{StaticResource FootVal}"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OnOpenSummary" Style="{StaticResource FooterButton}"
                                ToolTip="Open the full report">
                            <StackPanel>
                                <TextBlock Text="WEEK" Style="{StaticResource FootKey}"/>
                                <TextBlock Text="{Binding WeekTotal}" Style="{StaticResource FootVal}"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OnOpenSummary" Style="{StaticResource FooterButton}"
                                ToolTip="Open the full report">
                            <StackPanel>
                                <TextBlock Text="MONTH" Style="{StaticResource FootKey}"/>
                                <TextBlock Text="{Binding MonthTotal}" Style="{StaticResource FootVal}"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Border>

                <!-- The same actions the tray menu offers. They were reachable only by
                     right-clicking a tray icon, which is where features go to be undiscovered. -->
                <UniformGrid Columns="2" Margin="0,11,0,0">
                    <Button Content="Review / edit" Click="OnReview"
                            Style="{StaticResource Ghost}" Margin="0,0,3,0"
                            ToolTip="Check and correct today's hours and activities"/>
                    <Button Content="Report" Click="OnOpenSummary"
                            Style="{StaticResource Ghost}" Margin="3,0,0,0"
                            ToolTip="Day, week and month"/>
                </UniformGrid>

                <Button x:Name="BtnComplete" Content="Complete day" Click="OnCompleteDay"
                        Margin="0,6,0,0" Style="{StaticResource Ghost}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
