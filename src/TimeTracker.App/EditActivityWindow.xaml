<Window x:Class="TimeTracker.App.EditActivityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Border Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="#E4E6EA">
        <Border.Effect>
            <DropShadowEffect Color="#16181D" BlurRadius="28" ShadowDepth="6" Opacity="0.22"/>
        </Border.Effect>

        <StackPanel>
            <Border Height="3" Background="#F2A03D" CornerRadius="8,8,0,0"/>

            <StackPanel Margin="24,20,24,22">
                <TextBlock x:Name="HeadingText" Text="Edit activity" Foreground="#16181D"
                           FontSize="20" FontWeight="Bold" FontFamily="Segoe UI"/>
                <TextBlock x:Name="IdText" Foreground="#6B7280" FontSize="11"
                           FontFamily="Consolas" Margin="0,4,0,18"/>

                <TextBlock x:Name="TitleLabel" Text="TASK" Style="{StaticResource DialogLabel}"/>
                <TextBox x:Name="TitleBox" Style="{StaticResource DialogInput}"/>

                <TextBlock x:Name="CustomerLabel" Text="CUSTOMER" Style="{StaticResource DialogLabel}"/>
                <TextBox x:Name="CustomerBox" Style="{StaticResource DialogInput}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="StartLabel" Text="START" Style="{StaticResource DialogLabel}"/>
                        <TextBox x:Name="StartBox" Style="{StaticResource DialogInput}"
                                 FontFamily="Consolas" FontSize="15"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="EndLabel" Text="END" Style="{StaticResource DialogLabel}"/>
                        <TextBox x:Name="EndBox" Style="{StaticResource DialogInput}"
                                 FontFamily="Consolas" FontSize="15"/>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="StatusPanel">
                    <TextBlock Text="STATUS" Style="{StaticResource DialogLabel}"/>
                    <ComboBox x:Name="StatusBox" Margin="0,0,0,14" Padding="8,6"
                              FontFamily="Segoe UI" FontSize="14"/>
                </StackPanel>

                <TextBlock x:Name="DescriptionLabel" Text="DESCRIPTION (OPTIONAL)" Style="{StaticResource DialogLabel}"/>
                <TextBox x:Name="DescriptionBox" Style="{StaticResource DialogInput}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="56"
                         VerticalScrollBarVisibility="Auto"/>

                <TextBlock x:Name="ErrorText" Foreground="#C0392B" FontSize="12"
                           FontFamily="Segoe UI" Margin="0,0,0,10" Visibility="Collapsed"
                           TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="OnCancel" Style="{StaticResource DialogGhost}"
                            Margin="0,0,8,0" IsCancel="True"/>
                    <Button Content="Save" Click="OnConfirm"
                            Style="{StaticResource DialogPrimary}" IsDefault="True"/>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
