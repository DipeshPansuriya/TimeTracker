<Window x:Class="TimeTracker.App.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Border Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="#E4E6EA">
        <Border.Effect>
            <DropShadowEffect Color="#16181D" BlurRadius="28" ShadowDepth="6" Opacity="0.22"/>
        </Border.Effect>

        <StackPanel>
            <Border Height="3" Background="#F2A03D" CornerRadius="8,8,0,0"/>

            <StackPanel Margin="24,20,24,22">
                <TextBlock Text="Review today" Foreground="#16181D"
                           FontSize="20" FontWeight="Bold" FontFamily="Segoe UI"/>
                <TextBlock x:Name="SubText" Foreground="#6B7280" FontSize="12"
                           FontFamily="Segoe UI" Margin="0,4,0,18"/>

                <!-- KPI stripe. Colour encodes state only: neutral figures stay graphite. -->
                <UniformGrid Columns="4" Margin="0,0,0,18">
                    <Border x:Name="KpiWorked" BorderThickness="0,3,0,0" BorderBrush="#16181D"
                            Background="#F7F8F9" Padding="10,8" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="WORKED" Style="{StaticResource DialogLabel}"/>
                            <TextBlock x:Name="WorkedText" Foreground="#16181D" FontSize="18"
                                       FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>
                    <Border BorderThickness="0,3,0,0" BorderBrush="#16181D"
                            Background="#F7F8F9" Padding="10,8" Margin="3,0">
                        <StackPanel>
                            <TextBlock Text="REQUIRED" Style="{StaticResource DialogLabel}"/>
                            <TextBlock x:Name="RequiredText" Foreground="#16181D" FontSize="18"
                                       FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="KpiBalance" BorderThickness="0,3,0,0" BorderBrush="#16181D"
                            Background="#F7F8F9" Padding="10,8" Margin="3,0">
                        <StackPanel>
                            <TextBlock x:Name="BalanceKey" Text="BALANCE" Style="{StaticResource DialogLabel}"/>
                            <TextBlock x:Name="BalanceText" Foreground="#16181D" FontSize="18"
                                       FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="KpiStatus" BorderThickness="0,3,0,0" BorderBrush="#16181D"
                            Background="#F7F8F9" Padding="10,8" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="STATUS" Style="{StaticResource DialogLabel}"/>
                            <TextBlock x:Name="StatusText" Foreground="#16181D" FontSize="14"
                                       FontWeight="SemiBold" FontFamily="Segoe UI"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Margin="0,0,0,2">
                    <TextBlock Text="ACTIVITIES  ·  CLICK A ROW TO EDIT"
                               Style="{StaticResource DialogLabel}"/>
                    <Button Content="Edit time in / out" Click="OnEditHours"
                            HorizontalAlignment="Right" Margin="0,-4,0,0"
                            Style="{StaticResource DialogGhost}" Padding="10,3" FontSize="11"/>
                </Grid>
                <ItemsControl x:Name="TaskList" Margin="0,0,0,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="OnEditActivity" Style="{StaticResource RowButton}"
                                    ToolTip="Edit this activity">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}" Foreground="#16181D"
                                                   FontSize="13" FontFamily="Segoe UI"/>
                                        <TextBlock Text="{Binding Customer}" Foreground="#6B7280"
                                                   FontSize="11" FontFamily="Segoe UI"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Times}"
                                               Foreground="#6B7280" FontSize="12"
                                               FontFamily="Consolas" VerticalAlignment="Center"
                                               Margin="0,0,14,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Duration}"
                                               Foreground="#16181D" FontSize="13"
                                               FontFamily="Consolas" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Only shown when something is actually missing (§23). -->
                <Border x:Name="GapPanel" BorderThickness="4,1,1,1" BorderBrush="#B4671F"
                        Background="#FDF3E6" Padding="12,10" Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Missing information" Foreground="#16181D"
                                   FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="GapText" Foreground="#16181D" FontSize="12"
                                   FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Keep working" Click="OnCancel"
                            Style="{StaticResource DialogGhost}" Margin="0,0,8,0" IsCancel="True"/>
                    <Button Content="Complete day" Click="OnConfirm"
                            Style="{StaticResource DialogPrimary}" IsDefault="True"/>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
