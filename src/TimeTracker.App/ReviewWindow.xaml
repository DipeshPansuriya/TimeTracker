<Window x:Class="TimeTracker.App.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Border Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="#ECECE4">
        <Border.Effect>
            <DropShadowEffect Color="#081F4B" BlurRadius="28" ShadowDepth="6" Opacity="0.22"/>
        </Border.Effect>

        <StackPanel>
            <Border Height="4" Background="#081F4B" CornerRadius="8,8,0,0"/>

            <StackPanel Margin="24,20,24,22">
                <TextBlock Text="Review today" Foreground="#081F4B"
                           FontSize="20" FontWeight="Bold" FontFamily="Segoe UI"/>
                <TextBlock x:Name="SubText" Foreground="#585858" FontSize="12"
                           FontFamily="Segoe UI" Margin="0,4,0,18"/>

                <!-- KPI stripe. Colour encodes state only: neutral figures stay Deep Sea. -->
                <UniformGrid Columns="4" Margin="0,0,0,18">
                    <Border x:Name="KpiWorked" BorderThickness="0,3,0,0" BorderBrush="#081F4B"
                            Background="#FAFAF7" Padding="10,8" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="WORKED" Style="{StaticResource DialogLabel}"/>
                            <TextBlock x:Name="WorkedText" Foreground="#081F4B" FontSize="18"
                                       FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>
                    <Border BorderThickness="0,3,0,0" BorderBrush="#081F4B"
                            Background="#FAFAF7" Padding="10,8" Margin="3,0">
                        <StackPanel>
                            <TextBlock Text="REQUIRED" Style="{StaticResource DialogLabel}"/>
                            <TextBlock x:Name="RequiredText" Foreground="#081F4B" FontSize="18"
                                       FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="KpiBalance" BorderThickness="0,3,0,0" BorderBrush="#081F4B"
                            Background="#FAFAF7" Padding="10,8" Margin="3,0">
                        <StackPanel>
                            <TextBlock x:Name="BalanceKey" Text="BALANCE" Style="{StaticResource DialogLabel}"/>
                            <TextBlock x:Name="BalanceText" Foreground="#081F4B" FontSize="18"
                                       FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="KpiStatus" BorderThickness="0,3,0,0" BorderBrush="#081F4B"
                            Background="#FAFAF7" Padding="10,8" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="STATUS" Style="{StaticResource DialogLabel}"/>
                            <TextBlock x:Name="StatusText" Foreground="#081F4B" FontSize="14"
                                       FontWeight="SemiBold" FontFamily="Segoe UI"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Text="ACTIVITIES" Style="{StaticResource DialogLabel}"/>
                <ItemsControl x:Name="TaskList" Margin="0,0,0,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Title}" Foreground="#081F4B"
                                               FontSize="13" FontFamily="Segoe UI"/>
                                    <TextBlock Text="{Binding Customer}" Foreground="#585858"
                                               FontSize="11" FontFamily="Segoe UI"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Duration}"
                                           Foreground="#081F4B" FontSize="13"
                                           FontFamily="Consolas" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Only shown when something is actually missing (§23). -->
                <Border x:Name="GapPanel" BorderThickness="4,1,1,1" BorderBrush="#E65100"
                        Background="#FFF3E0" Padding="12,10" Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Missing information" Foreground="#081F4B"
                                   FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="GapText" Foreground="#202020" FontSize="12"
                                   FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Keep working" Click="OnCancel"
                            Style="{StaticResource DialogGhost}" Margin="0,0,8,0" IsCancel="True"/>
                    <Button Content="Complete day" Click="OnConfirm"
                            Style="{StaticResource DialogPrimary}" IsDefault="True"/>
                </StackPanel>
            </StackPanel>

            <Border Height="4" Background="#EB4A26" CornerRadius="0,0,8,8"/>
        </StackPanel>
    </Border>
</Window>
