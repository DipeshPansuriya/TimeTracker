<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- For the tray icon and its balloon notifications. WPF ships no NotifyIcon of its
         own, and the WinForms one avoids both an extra dependency and the AppUserModelID
         registration that real Windows toasts require. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>TimeTracker</AssemblyName>
    <RootNamespace>TimeTracker.App</RootNamespace>
    <!-- Shows on the exe, the Start Menu shortcut and the taskbar. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms are both referenced (WinForms only for the tray icon), and they
         collide on a handful of type names. Aliasing them once here beats qualifying every
         use site and forgetting one. -->
    <Using Include="System.Windows.MessageBox" Alias="MessageBox" />
    <Using Include="System.Windows.Controls.Control" Alias="Control" />
    <Using Include="System.Windows.Controls.CheckBox" Alias="CheckBox" />
    <Using Include="System.Windows.Controls.TextBox" Alias="TextBox" />
    <Using Include="System.Windows.Media.Brush" Alias="Brush" />
    <Using Include="System.Windows.Application" Alias="Application" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also embedded, so the tray icon is loaded from a known resource rather than
         extracted from the exe - extraction returns a single size and looks blurry
         at tray scale. -->
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TimeTracker.Core\TimeTracker.Core.csproj" />
    <ProjectReference Include="..\TimeTracker.Storage\TimeTracker.Storage.csproj" />
  </ItemGroup>

</Project>
