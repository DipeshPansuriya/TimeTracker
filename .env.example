# TimeTracker Environment Variables
# Copy this file to .env and fill in your local values
# NEVER commit .env file to version control

# Database Connection
ConnectionStrings__DefaultConnection=Server=localhost;Database=TimeTracker;User Id=sa;Password=YourPassword123!;Encrypt=false;TrustServerCertificate=true

# JWT Settings
Jwt__Key=your-secret-key-here-must-be-at-least-32-characters-long-for-security
Jwt__Issuer=TimeTracker
Jwt__Audience=TimeTrackerUsers
Jwt__ExpirationMinutes=60

# CORS Settings
CORS__AllowedOrigins=http://localhost:3000,http://localhost:5000,https://timetracker.example.com

# Logging
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft=Warning
Logging__LogLevel__Microsoft.EntityFrameworkCore=Information

# Application Settings
App__Name=TimeTracker
App__Version=1.0.0
App__Environment=Development

# Email (Optional)
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__From=noreply@timetracker.com
Email__Username=your-email@gmail.com
Email__Password=your-app-password

# API Keys (if using external services)
OPENAI_API_KEY=sk-your-openai-api-key-here
SONA_TOKEN=your-sonarcloud-token
